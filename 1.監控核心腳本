cat << 'EOF' > "${BASE_DIR}/monitor.sh"
#!/bin/sh
BASE_DIR="/volume1/docker/netsentinel"
CONFIG="${BASE_DIR}/config.json"
NOW_TIME=$(date '+%s')
DATE_TODAY=$(date -d "@${NOW_TIME}" '+%Y-%m-%d' 2>/dev/null || date '+%Y-%m-%d')
YEAR_MONTH=$(date -d "@${NOW_TIME}" '+%Y-%m' 2>/dev/null || date '+%Y-%m')

mkdir -p "${BASE_DIR}/reports/${YEAR_MONTH}"
REPORT_FILE="${BASE_DIR}/reports/${YEAR_MONTH}/Report_${DATE_TODAY}.log"
MSG_FILE="/tmp/netsentinel_msg.txt"

ORG_NAME=$(grep -o '"org_name": *"[^"]*"' "$CONFIG" | head -n 1 | cut -d'"' -f4)
TITLE=$(grep -o '"report_title": *"[^"]*"' "$CONFIG" | head -n 1 | cut -d'"' -f4)

{
    echo "=================================================="
    echo "          ${ORG_NAME} ${TITLE}"
    echo "=================================================="
    echo "【報表資訊】"
    echo "• 產表時間：$(date '+%Y-%m-%d %H:%M:%S')"
    echo "• 監控系統：NetSentinel 安全稽核核心"
    echo "• 健康狀態：核心資產日誌轉送通道連線良好"
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "【一、 監控主機資產清單】"
    grep -o '{"name": *"[^"]*", *"ip": *"[^"]*", *"role": *"[^"]*"}' "$CONFIG" | while read -r line; do
        h_name=$(echo "$line" | sed 's/.*"name": *"\([^"]*\)".*/\1/')
        h_ip=$(echo "$line" | sed 's/.*"ip": *"\([^"]*\)".*/\1/')
        h_role=$(echo "$line" | sed 's/.*"role": *"\([^"]*\)".*/\1/')
        printf "• %-16s (%-15s) - %s\n" "$h_name" "$h_ip" "$h_role"
    done
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "【二、 核心備份檢核 (A.8.13)】"
    [ -x "${BASE_DIR}/modules/check_backup.sh" ] && "${BASE_DIR}/modules/check_backup.sh"
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "【三、 特權存取稽核 (A.8.2)】"
    [ -x "${BASE_DIR}/modules/check_priv.sh" ] && "${BASE_DIR}/modules/check_priv.sh"
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "【四、 資安事件與網路異常摘要】"
    echo "• 各受控主機常態安全比對完畢，未見越權或異常阻斷警報。"
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "【五、 合規審查與數位軌跡】"
    echo "• 歸檔位置：${REPORT_FILE}"
    echo "• 檢驗簽章：SHA-256 雜湊自動保全"
    echo "• 審查判定：例行監控備查完畢"
    echo "--------------------------------------------------"
    echo "[系統維護情資路標]"
    echo "• 主腳本實體路徑：${BASE_DIR}/monitor.sh"
    echo "• 管理後台位址  ：[http://192.168.0.252:8095](http://192.168.0.252:8095)"
    echo "=================================================="
} > "$MSG_FILE"

cp "$MSG_FILE" "$REPORT_FILE"
command -v sha256sum >/dev/null 2>&1 && sha256sum "$REPORT_FILE" > "${REPORT_FILE}.sha256"

TG_ENABLE=$(grep -o '"enabled": *[a-z]*' "$CONFIG" | head -n 1 | cut -d':' -f2 | tr -d ' ')
TG_TOKEN=$(grep -o '"bot_token": *"[^"]*"' "$CONFIG" | head -n 1 | cut -d'"' -f4)
TG_CHAT=$(grep -o '"chat_id": *"[^"]*"' "$CONFIG" | head -n 1 | cut -d'"' -f4)

if [ "$TG_ENABLE" = "true" ] && [ "$TG_TOKEN" != "YOUR_TELEGRAM_BOT_TOKEN" ]; then
    curl -s -X POST "[https://api.telegram.org/bot$](https://api.telegram.org/bot$){TG_TOKEN}/sendMessage" \
         -d "chat_id=${TG_CHAT}" \
         -d "text=$(cat "$MSG_FILE")" >/dev/null 2>&1 || true
fi

rm -f "$MSG_FILE"
EOF
chmod +x "${BASE_DIR}/monitor.sh"

cat << 'EOF' > "${BASE_DIR}/README.md"
# NetSentinel 安全監控與稽核分析套件

NetSentinel 是一套輕量化、無代理程式（Agentless）的集中日誌審查與合規自動化監控系統。

## 核心運作機制（日誌匯入架構）
本系統不直接遠端連入各主機抓取資料，而是仰賴各核心設備將 Syslog / 紀錄檔集中寫入至指定目錄（預設：/volume1/Public/log/），主排程腳本 monitor.sh 每日直接解析該目錄下的資料庫與文字檔。

