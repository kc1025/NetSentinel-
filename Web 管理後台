import http.server
import socketserver
import json
import os
import urllib.parse
import hashlib
import uuid
import http.cookies

PORT = 8095
CONFIG_PATH = "/volume1/docker/netsentinel/config.json"
SESSIONS = {}

def sha256_hash(text):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()

def get_config():
    with open(CONFIG_PATH, "r", encoding="utf-8") as f:
        return json.load(f)

def save_config(cfg):
    with open(CONFIG_PATH, "w", encoding="utf-8") as f:
        json.dump(cfg, f, ensure_ascii=False, indent=2)

