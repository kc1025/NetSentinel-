class SentinelHandler(http.server.SimpleHTTPRequestHandler):
    def get_session(self):
        cookie = self.headers.get("Cookie")
        if not cookie: return None
        c = http.cookies.SimpleCookie(cookie)
        if "session_token" in c:
            return SESSIONS.get(c["session_token"].value)
        return None

    def send_redirect(self, loc, cookie=None):
        self.send_response(303)
        self.send_header("Location", loc)
        if cookie: self.send_header("Set-Cookie", cookie)
        self.end_headers()

    def do_GET(self):
        user = self.get_session()
        if self.path == "/login":
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(HTML_LOGIN.replace("__ERR__", "").encode("utf-8"))
            return

        if self.path == "/logout":
            cookie = self.headers.get("Cookie")
            if cookie:
                c = http.cookies.SimpleCookie(cookie)
                if "session_token" in c: SESSIONS.pop(c["session_token"].value, None)
            self.send_redirect("/login", "session_token=; Max-Age=0; Path=/")
            return

        if not user:
            self.send_redirect("/login")
            return

        cfg = get_config()
        if cfg.get("auth", {}).get("must_change_pwd", False):
            if self.path != "/change_pwd":
                self.send_redirect("/change_pwd")
                return
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(HTML_CHANGE_PWD.replace("__ERR__", "").encode("utf-8"))
            return

        if self.path == "/change_pwd":
            self.send_redirect("/")
            return

        if self.path == "/" or self.path.startswith("/?"):
            html = HTML_MAIN
            html = html.replace("__ORG_NAME__", cfg.get("system", {}).get("org_name", ""))
            html = html.replace("__REPORT_TITLE__", cfg.get("system", {}).get("report_title", ""))
            html = html.replace("__LOG_IMPORT_DIR__", cfg.get("system", {}).get("log_import_dir", "/volume1/Public/log"))
            
            is_tg_enabled = cfg.get("notifications", {}).get("telegram", {}).get("enabled", True)
            html = html.replace("__TG_OPT_ENABLED__", "selected" if is_tg_enabled else "")
            html = html.replace("__TG_OPT_DISABLED__", "selected" if not is_tg_enabled else "")
            html = html.replace("__TG_TOKEN__", cfg.get("notifications", {}).get("telegram", {}).get("bot_token", ""))
            html = html.replace("__TG_CHAT__", cfg.get("notifications", {}).get("telegram", {}).get("chat_id", ""))
            html = html.replace("__ADMIN_USER__", cfg.get("auth", {}).get("username", "admin"))

            h_rows = "".join([f'<tr><td><input type="text" value="{h.get("name","")}"></td><td><input type="text" value="{h.get("ip","")}"></td><td><input type="text" value="{h.get("role","")}"></td><td style="text-align:center;"><button type="button" class="btn-del" onclick="this.closest(\'tr\').remove()">刪除</button></td></tr>' for h in cfg.get("hosts", [])])
            html = html.replace("__HOSTS_ROWS__", h_rows)

            u_rows = "".join([f'<tr><td><input type="text" value="{u_ip}"></td><td><input type="text" value="{u_name}"></td><td style="text-align:center;"><button type="button" class="btn-del" onclick="this.closest(\'tr\').remove()">刪除</button></td></tr>' for u_ip, u_name in cfg.get("users", {}).items()])
            html = html.replace("__USERS_ROWS__", u_rows)

            if "saved=1" in self.path: html = html.replace("display: none;", "display: block;")

            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(html.encode("utf-8"))
        else:
            self.send_error(404)

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        params = urllib.parse.parse_qs(self.rfile.read(length).decode("utf-8"))

        if self.path == "/login":
            u, p = params.get("username", [""])[0], params.get("password", [""])[0]
            cfg = get_config()
            if u == cfg.get("auth", {}).get("username") and sha256_hash(p) == cfg.get("auth", {}).get("password_hash"):
                token = str(uuid.uuid4())
                SESSIONS[token] = u
                target = "/change_pwd" if cfg.get("auth", {}).get("must_change_pwd", False) else "/"
                self.send_redirect(target, f"session_token={token}; Path=/; HttpOnly")
            else:
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                self.wfile.write(HTML_LOGIN.replace("__ERR__", '<div class="err">帳號或密碼錯誤！</div>').encode("utf-8"))
            return

        user = self.get_session()
        if not user:
            self.send_redirect("/login")
            return

        if self.path == "/change_pwd":
            p1, p2 = params.get("new_pwd", [""])[0], params.get("confirm_pwd", [""])[0]
            if len(p1) < 6 or p1 != p2:
                err_msg = "密碼長度至少需 6 個字元！" if len(p1) < 6 else "兩次輸入的新密碼不一致！"
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                self.wfile.write(HTML_CHANGE_PWD.replace("__ERR__", f'<div class="err">{err_msg}</div>').encode("utf-8"))
                return
            cfg = get_config()
            cfg["auth"]["password_hash"] = sha256_hash(p1)
            cfg["auth"]["must_change_pwd"] = False
            save_config(cfg)
            self.send_redirect("/?saved=1")
            return

        if self.path == "/save":
            cfg = get_config()
            cfg["system"]["org_name"] = params.get("org_name", [""])[0]
            cfg["system"]["report_title"] = params.get("report_title", [""])[0]
            cfg["system"]["log_import_dir"] = params.get("log_import_dir", ["/volume1/Public/log"])[0]
            
            tg_status = params.get("tg_status", ["enabled"])[0]
            cfg["notifications"]["telegram"]["enabled"] = (tg_status == "enabled")
            cfg["notifications"]["telegram"]["bot_token"] = params.get("tg_token", [""])[0]
            cfg["notifications"]["telegram"]["chat_id"] = params.get("tg_chat", [""])[0]

            admin_user = params.get("admin_username", [""])[0].strip()
            if admin_user:
                cfg["auth"]["username"] = admin_user

            new_p = params.get("new_password", [""])[0]
            conf_p = params.get("confirm_password", [""])[0]
            if new_p:
                if len(new_p) >= 6 and new_p == conf_p:
                    cfg["auth"]["password_hash"] = sha256_hash(new_p)

            try: cfg["hosts"] = json.loads(params.get("hosts_json", ["[]"])[0])
            except: pass
            try: cfg["users"] = json.loads(params.get("users_json", ["{}"])[0])
            except: pass

            save_config(cfg)
            self.send_redirect("/?saved=1")

class ThreadingHTTPServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True

if __name__ == "__main__":
    os.chdir(os.path.dirname(CONFIG_PATH))
    server = ThreadingHTTPServer(("", PORT), SentinelHandler)
    server.serve_forever()
